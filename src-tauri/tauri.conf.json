{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Liplo",
  "mainBinaryName": "liplo",
  "version": "0.1.0",
  "identifier": "com.liplo.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:7050",
    "frontendDist": "../desktop-shell"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Liplo - Flow of Live Interaction",
        "width": 1440,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://127.0.0.1:7050 http://localhost:7050 data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:7050 http://127.0.0.1:7051 ws://127.0.0.1:7051 ws://127.0.0.1:4455 http://localhost:7050 http://localhost:7051 ws://localhost:7051 ws://localhost:4455"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/liplo-runtime"
    ],
    "resources": [
      "resources/sidecars/*",
      "resources/liplo-runtime/**/*"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
