DATABASE_URL="mysql://root:password@localhost:3306/tiktok_live_automation"
NEXT_PUBLIC_SOCKET_URL="http://localhost:7050"
NEXT_PUBLIC_WIDGET_BASE_URL="http://localhost:7050"
# Optional split runtime mode:
# REALTIME_PORT="7051"
# REALTIME_CONTROL_URL="http://127.0.0.1:7051"
# REALTIME_CONTROL_TOKEN="change-me"
TIKTOK_RECONNECT_MAX_ATTEMPTS="0"
TIKTOK_RECONNECT_MAX_DELAY_MS="30000"
TIKTOK_CONNECT_TIMEOUT_MS="25000"
# Connection mode:
# - auto: default behavior
# - nofetch: skip room info fetch at connect (if room info endpoint unstable)
TIKTOK_CONNECTION_MODE="auto"
# Keep false by default. Enabling this may require paid signer access.
TIKTOK_ENABLE_SIGNED_PREFETCH="false"
# Optional: custom signer endpoint.
# TIKTOK_SIGN_PROVIDER_HOST="https://your-tiktok-sign-host.example/"
# Optional: signer API key for TikTok signing.
# TIKTOK_SIGN_API_KEY=""
# Optional: isi sessionid dan tt-target-idc TikTok Anda untuk koneksi authenticated.
# TIKTOK_SESSION_ID=""
# TIKTOK_TT_TARGET_IDC=""
