{
  "name": "liplo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "pnpm prisma:generate",
    "dev": "tsx server.ts",
    "dev:web": "next dev -p 7050",
    "dev:next": "next dev -p 7050",
    "dev:realtime": "tsx realtime-server.ts",
    "dev:ws": "echo 'Realtime is included in pnpm dev. Starting the combined dev server...' && pnpm dev",
    "desktop:prepare": "node scripts/desktop/prepare-sidecars.mjs",
    "desktop:runtime:bundle": "node scripts/desktop/bundle-runtime.mjs",
    "desktop:runtime:build:mac:arm64": "node scripts/desktop/build-runtime-sidecar.mjs --target=aarch64-apple-darwin",
    "desktop:runtime:build:mac:x64": "node scripts/desktop/build-runtime-sidecar.mjs --target=x86_64-apple-darwin",
    "desktop:runtime:build:windows": "node scripts/desktop/build-runtime-sidecar.mjs --target=x86_64-pc-windows-msvc",
    "desktop:verify-release-sidecars": "node scripts/desktop/verify-release-sidecars.mjs",
    "build:desktop": "node scripts/desktop/build-desktop.mjs",
    "desktop:dev": "pnpm desktop:prepare && pnpm exec tauri dev",
    "desktop:build": "pnpm build:desktop && pnpm desktop:prepare && pnpm exec tauri build --bundles app",
    "desktop:build:windows": "pnpm build:desktop && pnpm desktop:prepare && pnpm exec tauri build --target x86_64-pc-windows-msvc",
    "desktop:build:mac": "pnpm build:desktop && pnpm desktop:prepare && pnpm exec tauri build --bundles app",
    "desktop:build:mac:arm64": "pnpm build:desktop && pnpm desktop:prepare && pnpm exec tauri build --target aarch64-apple-darwin --bundles app",
    "desktop:build:mac:x64": "pnpm build:desktop && pnpm desktop:prepare && pnpm exec tauri build --target x86_64-apple-darwin --bundles app",
    "desktop:release:mac": "pnpm desktop:verify-release-sidecars && pnpm desktop:build:mac",
    "desktop:release:windows": "pnpm desktop:verify-release-sidecars && pnpm desktop:build:windows",
    "build": "prisma generate && next build",
    "start": "NODE_ENV=production tsx server.ts",
    "start:web": "next start -p 7050",
    "start:next": "next start -p 7050",
    "start:realtime": "NODE_ENV=production tsx realtime-server.ts",
    "start:ws": "echo 'Realtime is included in pnpm start. Starting the combined production server...' && pnpm start",
    "lint": "eslint .",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "tauri:dev": "pnpm desktop:dev",
    "tauri:build": "pnpm desktop:build"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-wc": "^0.9.12",
    "@prisma/client": "^6.8.2",
    "@radix-ui/react-slot": "^1.1.1",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@xyflow/react": "^12.10.2",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.11.5",
    "next": "^15.1.3",
    "obs-websocket-js": "^5.0.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-moveable": "^0.56.0",
    "react-selecto": "^1.26.3",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^2.5.5",
    "tiktok-live-connector": "^2.4.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@tauri-apps/cli": "^2.11.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.28.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "postcss": "^8.4.49",
    "prisma": "^6.8.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@10.15.1"
}
